{
  "description": "Guards read-only investigator calls and records sanitized call metadata with pre/post reconciliation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|mcp__plugin_sre-agent_sre__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/readonly-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|mcp__plugin_sre-agent_sre__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/sre-agent/scripts/sre\" hook post || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Read|Grep|mcp__plugin_sre-agent_sre__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/sre-agent/scripts/sre\" hook post || true"
          }
        ]
      }
    ]
  }
}
